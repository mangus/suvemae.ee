# Copy to /etc/suvemae/opalstack.env on the agent server.
# Everything runs as the Opalstack user suvemaeweb on opal11; the school's
# WordPress (user "suvemae") is never touched.

# Static sites: suvemäe.ee and labor.suvemäe.ee.
STATIC_SSH=suvemaeweb@opal11.opalstack.com
WWW_DIR=/home/suvemaeweb/apps/suvemaeweb_avaleht
LABOR_DIR=/home/suvemaeweb/apps/suvemaeweb_labor

# Lab API: a "Custom/Proxy port" app routed at labor.suvemäe.ee/api. Its
# server/config.json (port, adminToken, projectsFile) lives only on Opalstack.
API_SSH=suvemaeweb@opal11.opalstack.com
API_DIR=/home/suvemaeweb/apps/suvemaeweb_laborapi/server
API_RESTART="./run.sh restart"

# Set to 1 once the first deploy looks right: also deletes files removed from the repo.
RSYNC_DELETE=0
