# Preview server on the agent server: https://agent1122.mintbot.ai/app/
# The platform proxies /app/ to 127.0.0.1:8700.
[Unit]
Description=Suvemäe labor preview server
After=network.target

[Service]
Environment=LABOR_CONFIG=/srv/suvemae/main/deploy/preview.json
ExecStart=/usr/bin/node /srv/suvemae/main/server/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
